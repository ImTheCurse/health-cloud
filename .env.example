# Copy to .env and fill in. .env is gitignored; never commit it.

# --- Postgres (consumed by docker-compose and the server) ---
POSTGRES_USER=healthcloud
POSTGRES_PASSWORD=healthcloud
POSTGRES_DB=healthcloud
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://healthcloud:healthcloud@localhost:5432/healthcloud

# --- App ---
ENVIRONMENT=local
LOG_LEVEL=INFO
# --- Google OAuth ---
# Identifies the app, not a user. From the GCP OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Both are 32 random bytes, hex encoded: openssl rand -hex 32
# TOKEN_ENCRYPTION_KEY encrypts stored Google tokens (AES-256-GCM).
# Losing it means every user must re-consent.
TOKEN_ENCRYPTION_KEY=
# SESSION_SECRET signs our session cookie (HS256).
SESSION_SECRET=

# --- session cookie ---
SESSION_TTL_MINUTES=60
# Keep false on plain http://localhost; true everywhere else.
COOKIE_SECURE=false
# Where the callback sends the browser after a successful consent.
FRONTEND_URL=http://localhost:5173

# --- webhook subscriber ---
# Subscriber management is a project-level API authorised by a service
# account, not by the per-user OAuth tokens.
GCP_PROJECT_NUMBER=
# Path to the service account key. Gitignored; never commit the file.
GOOGLE_APPLICATION_CREDENTIALS=service-account.json
# The subscriber's id, chosen by us when it is registered with Google.
SUBSCRIBER_ID=
# Registered with the subscriber and echoed back by Google in the
# Authorization header of every notification. Treat it as a password.
WEBHOOK_AUTH_SECRET=
# Public HTTPS origin Google delivers notifications to.
WEBHOOK_PUBLIC_URL=

# Exact origins allowed to send credentialed requests (comma separated).
CORS_ORIGINS=http://localhost:5173

# Echo SQL and bound parameters to the log. Leave false: the users table
# holds email and display name, so echoing writes PII to the logs.
SQL_ECHO=false
