# Copy to .env and fill in. .env is gitignored; never commit it.

# --- Postgres (consumed by docker-compose and the server) ---
POSTGRES_USER=healthcloud
POSTGRES_PASSWORD=healthcloud
POSTGRES_DB=healthcloud
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://healthcloud:healthcloud@localhost:5432/healthcloud

# --- App ---
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Step 2: Google OAuth (leave blank until then) ---
# Identifies the app, not a user. From the GCP OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Signs our own session JWT. Generate: openssl rand -hex 32
JWT_SECRET=

# Encrypts Google refresh tokens at rest. Library TBD at step 2.
# Eventually a mounted key file on the server; .env is fine locally.
TOKEN_ENCRYPTION_KEY=

# --- Step 4: webhook endpoint ---
WEBHOOK_PUBLIC_URL=
