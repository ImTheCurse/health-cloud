# Copy to .env and fill in. .env is gitignored; never commit it.
#
# The defaults run the app in containers (`docker compose up`): the API on
# localhost:7781, the dashboard on localhost:7780. To run the API and the
# dashboard directly on the host instead (`uv run uvicorn`, `npm run dev`),
# use the values marked "host:" -- the API is then on :8000 and Vite on :5173.
#
# DATABASE_URL, NATS_URL and PREFECT_API_URL stay on localhost either way:
# docker-compose.yml replaces them with service names inside the containers,
# and commands run on the host use them as written.

# --- Postgres (consumed by docker-compose and the server) ---
POSTGRES_USER=healthcloud
POSTGRES_PASSWORD=healthcloud
POSTGRES_DB=healthcloud
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://healthcloud:healthcloud@localhost:5432/healthcloud

# --- App ---
ENVIRONMENT=local
LOG_LEVEL=INFO
# --- Google OAuth ---
# Identifies the app, not a user. From the GCP OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must also be registered on the OAuth client in GCP.
# host: http://localhost:8000/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:7781/auth/google/callback

# Both are 32 random bytes, hex encoded: openssl rand -hex 32
# TOKEN_ENCRYPTION_KEY encrypts stored Google tokens (AES-256-GCM).
# Losing it means every user must re-consent.
TOKEN_ENCRYPTION_KEY=
# SESSION_SECRET signs our session cookie (HS256).
SESSION_SECRET=
# DATA_ENCRYPTION_KEY encrypts every stored health value (AES-256-GCM).
# Losing it makes the stored measurements unreadable; they can be re-backfilled.
DATA_ENCRYPTION_KEY=

# --- session cookie ---
SESSION_TTL_MINUTES=60
# Keep false on plain http://localhost; true everywhere else.
COOKIE_SECURE=false
# Where the callback sends the browser after a successful consent.
# host: http://localhost:5173
FRONTEND_URL=http://localhost:7780

# --- webhook subscriber ---
# Subscriber management is a project-level API authorised by a service
# account, not by the per-user OAuth tokens.
GCP_PROJECT_NUMBER=
# Path to the service account key. Gitignored; never commit the file.
GOOGLE_APPLICATION_CREDENTIALS=service-account.json
# The subscriber's id, chosen by us when it is registered with Google.
SUBSCRIBER_ID=
# Registered with the subscriber and echoed back by Google in the
# Authorization header of every notification. Treat it as a password.
WEBHOOK_AUTH_SECRET=
# Public HTTPS origin Google delivers notifications to.
WEBHOOK_PUBLIC_URL=

# --- message queue ---
# NATS with JetStream. Durability lives here: the receiver will not acknowledge
# a notification to Google until the broker confirms the message is persisted.
NATS_URL=nats://localhost:4222

# --- orchestration ---
# Prefect's REST API. The receiver posts one request here after acknowledging a
# notification, asking for a fetcher run; the queue, not this call, is what
# guarantees the work happens, so a failure here is logged and ignored.
PREFECT_API_URL=http://localhost:4200/api

# Exact origins allowed to send credentialed requests (comma separated).
# host: http://localhost:5173
CORS_ORIGINS=http://localhost:7780

# Echo SQL and bound parameters to the log. Leave false: the users table
# holds email and display name, so echoing writes PII to the logs.
SQL_ECHO=false

# --- containers (docker-compose.yml) ---
# Which published image tag Compose runs. `dev` is what a local
# `docker compose build` produces; a deployment following releases uses
# `latest`, or an exact version such as 0.1.0 to pin one.
APP_VERSION=
# Where the browser reaches the API, served to the client as /config.js.
# https://api.example.com-style in production. Unused by `npm run dev`, which
# reads VITE_API_BASE_URL and defaults to http://localhost:8000.
API_BASE_URL=http://localhost:7781
# Host ports, bound to 127.0.0.1. Defaults: 7781 and 7780.
API_PORT=
CLIENT_PORT=

# --- production ---
# A production .env differs from a development one in:
#   ENVIRONMENT=production
#   COOKIE_SECURE=true
#   FRONTEND_URL, CORS_ORIGINS   the dashboard's public origin
#   GOOGLE_REDIRECT_URI          <API origin>/auth/google/callback, also
#                                registered on the GCP OAuth client
#   API_BASE_URL                 the API's public origin
