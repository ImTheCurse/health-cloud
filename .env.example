# Copy to .env and fill in. .env is gitignored; never commit it.

# --- Postgres (consumed by docker-compose and the server) ---
POSTGRES_USER=healthcloud
POSTGRES_PASSWORD=healthcloud
POSTGRES_DB=healthcloud
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://healthcloud:healthcloud@localhost:5432/healthcloud

# --- App ---
ENVIRONMENT=local
LOG_LEVEL=INFO
# --- Step 2: Google OAuth ---
# Identifies the app, not a user. From the GCP OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Both are 32 random bytes, hex encoded: openssl rand -hex 32
# TOKEN_ENCRYPTION_KEY encrypts stored Google tokens (AES-256-GCM).
# Losing it means every user must re-consent.
TOKEN_ENCRYPTION_KEY=
# SESSION_SECRET signs our session cookie (HS256).
SESSION_SECRET=

# --- Step 2: session cookie ---
SESSION_TTL_MINUTES=60
# Keep false on plain http://localhost; true everywhere else.
COOKIE_SECURE=false
# Where the callback sends the browser after a successful consent.
FRONTEND_URL=http://localhost:5173

# --- Step 4: webhook endpoint ---
WEBHOOK_PUBLIC_URL=

# Exact origins allowed to send credentialed requests (comma separated).
CORS_ORIGINS=http://localhost:5173

# Echo SQL and bound parameters to the log. Leave false: the users table
# holds email and display name, so echoing writes PII to the logs.
SQL_ECHO=false
